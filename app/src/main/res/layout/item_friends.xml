<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginEnd="14dp"
    android:clickable="true"
    android:focusable="true">

    <!-- ─────────────────────────────── -->
    <!--  ADD FRIEND button (type = 0)   -->
    <!-- ─────────────────────────────── -->

    <LinearLayout
        android:id="@+id/layoutAddFriend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAddFriend"
            android:layout_width="62dp"
            android:layout_height="62dp"
            app:cardCornerRadius="31dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#18FFFFFF"
            app:strokeColor="#35C4A882"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_add"
                app:tint="#C4A882"
                android:layout_gravity="center"/>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:text="Add"
            android:textColor="#38C4A882"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"/>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/layoutFriendItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp">

            <!-- Glow ring — color controlled by adapter (active vs inactive) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvFriendRing"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                app:cardCornerRadius="34dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#30C4A882"
                app:strokeColor="#00000000"
                app:strokeWidth="0dp"/>

            <!-- Avatar card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvFriendAvatar"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                app:cardCornerRadius="29dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1008"
                app:strokeColor="#00000000"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivFriend"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"/>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <TextView
            android:id="@+id/tvFriendName"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:text="Friend"
            android:textColor="#80C4A882"
            android:textSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"/>

    </LinearLayout>

</LinearLayout>
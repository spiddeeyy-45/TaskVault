<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0905"
        tools:context=".on_boarding_screen">

        <!-- ─────────────────────────────────── -->
        <!--       AMBIENT BACKGROUND GLOWS      -->
        <!-- ─────────────────────────────────── -->

        <View
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-100dp"
            android:background="@drawable/bg_glow_top"
            android:alpha="0.30"/>

        <View
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="-80dp"
            android:layout_marginEnd="-80dp"
            android:background="@drawable/bg_glow_bottom"
            android:alpha="0.20"/>

        <!-- ─────────────────────────────────── -->
        <!--          MAIN LAYOUT                -->
        <!-- ─────────────────────────────────── -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ─────────────────────────────── -->
            <!--         SKIP BUTTON             -->
            <!-- ─────────────────────────────── -->

            <TextView
                android:id="@+id/tvSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="24dp"
                android:text="Skip"
                android:textColor="#50C4A882"
                android:textSize="13sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.06"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_skip_button"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- ─────────────────────────────── -->
            <!--         VIEW PAGER              -->
            <!-- ─────────────────────────────── -->

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/onboardimages"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvSkip"
                app:layout_constraintBottom_toTopOf="@id/bottomCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- ─────────────────────────────── -->
            <!--       GLASS BOTTOM CARD         -->
            <!-- ─────────────────────────────── -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bottomCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="#16C4A882"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="#28C4A882"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Dot indicators -->
                    <LinearLayout
                        android:id="@+id/dots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <!-- Page number label -->
                    <TextView
                        android:id="@+id/tvPageCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 / 4"
                        android:textColor="#30C4A882"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="0.08"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/dots"
                        app:layout_constraintBottom_toBottomOf="@id/dots"/>

                    <!-- Get Started / Next button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/getstartedbutton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#C4A882"
                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintTop_toBottomOf="@id/dots"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/tvButtonLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="Let's Get Started"
                                android:textColor="#1A0E05"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.04"/>

                            <!-- Next arrow icon (visible on non-last pages) -->
                            <ImageView
                                android:id="@+id/nexticon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="20dp"
                                android:src="@drawable/ic_chevron"
                                app:tint="#1A0E05"
                                android:alpha="0.6"/>

                        </RelativeLayout>

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>
</layout>
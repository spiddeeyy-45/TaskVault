<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="450dp"
    android:layout_margin="30dp"
    app:cardCornerRadius="32dp"
    app:cardElevation="20dp"
    android:background="@drawable/glassback"
    app:strokeColor="#26FFFFFF"
    app:strokeWidth="1dp"
    app:cardMaxElevation="24dp"
    android:outlineAmbientShadowColor="#40000000"
    android:outlineSpotShadowColor="#40000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:orientation="vertical"
        android:background="@drawable/back"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <!-- Lock Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1AFFFFFF"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_lock"
                app:tint="#D4AF37"
                android:layout_gravity="center"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Password"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#F5F5DC"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:layout_marginBottom="8dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update your account password"
            android:textColor="#A68A64"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="32dp"/>

        <!-- Input Fields Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#26FFFFFF"
            app:strokeColor="#4DFFFFFF"
            app:strokeWidth="1.5dp"
            app:cardMaxElevation="20dp"
            android:outlineAmbientShadowColor="#40000000"
            android:outlineSpotShadowColor="#40000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glassback"
                android:padding="20dp">

                <!-- Old Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/oldPassLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Old Password"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#A68A64"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#A68A64"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="#A68A64"
                    android:textColorHint="#A68A64"
                    app:hintAnimationEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOldPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#F5F5DC"
                        android:textSize="16sp"
                        android:textColorHint="#80A68A64"
                        android:fontFamily="sans-serif"
                        android:inputType="textPassword"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- New Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/newPassLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="New Password"
                    android:layout_marginTop="12dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#A68A64"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#A68A64"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="#A68A64"
                    android:textColorHint="#A68A64"
                    app:hintAnimationEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#F5F5DC"
                        android:textSize="16sp"
                        android:textColorHint="#80A68A64"
                        android:fontFamily="sans-serif"
                        android:inputType="textPassword"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/back"
        tools:context="LoginHandler.SignUp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/logo_vault"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/logo"
                android:contentDescription="Vault Logo"
                android:layout_marginTop="16dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/vault_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to Vault"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#F5F5DC"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="-16dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/vault_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create your account"
                android:textColor="#A68A64"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="32dp" />

            <!-- Card Container for Input Fields -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#26FFFFFF"
                app:strokeColor="#4DFFFFFF"
                app:strokeWidth="1.5dp"
                app:cardMaxElevation="20dp"
                android:outlineAmbientShadowColor="#40000000"
                android:outlineSpotShadowColor="#40000000">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Full Name Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fullname_input"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#A68A64"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#A68A64"
                        android:textColorHint="#A68A64"
                        app:hintAnimationEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#F5F5DC"
                            android:textSize="16sp"
                            android:textColorHint="#80A68A64"
                            android:fontFamily="sans-serif"
                            android:inputType="textPersonName"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/email_input"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email Address"
                        android:layout_marginTop="12dp"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#A68A64"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#A68A64"
                        android:textColorHint="#A68A64"
                        app:hintAnimationEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#F5F5DC"
                            android:textSize="16sp"
                            android:textColorHint="#80A68A64"
                            android:fontFamily="sans-serif"
                            android:inputType="textEmailAddress"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Phone Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/phone_input"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Phone Number"
                        android:layout_marginTop="12dp"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#A68A64"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#A68A64"
                        android:textColorHint="#A68A64"
                        app:hintAnimationEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#F5F5DC"
                            android:textSize="16sp"
                            android:textColorHint="#80A68A64"
                            android:fontFamily="sans-serif"
                            android:inputType="phone"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/password_input"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password"
                        android:layout_marginTop="12dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#A68A64"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#A68A64"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#A68A64"
                        android:textColorHint="#A68A64"
                        app:hintAnimationEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#F5F5DC"
                            android:textSize="16sp"
                            android:textColorHint="#80A68A64"
                            android:fontFamily="sans-serif"
                            android:inputType="textPassword"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sign Up Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/signup_btn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                app:cornerRadius="12dp"
                app:elevation="4dp"
                android:layout_marginTop="24dp"
                style="@style/Widget.Material3.Button" />

            <!-- Already Have Account Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/already_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? Login"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#A68A64"
                android:layout_marginTop="16dp"
                android:stateListAnimator="@null"
                style="@style/Widget.Material3.Button.TextButton" />

        </LinearLayout>
    </ScrollView>
</layout>
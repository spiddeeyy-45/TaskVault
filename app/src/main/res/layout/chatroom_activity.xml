<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="ChatLogic.chatroom_activity">

        <!-- ───────────────────────────────────── -->
        <!--       AMBIENT BACKGROUND GLOW         -->
        <!-- ───────────────────────────────────── -->

        <!-- Top warm glow blob -->
        <View
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-80dp"
            android:background="@drawable/bg_glow_top"
            android:alpha="0.35"/>

        <!-- Bottom glow blob -->
        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="-60dp"
            android:layout_marginEnd="-60dp"
            android:background="@drawable/bg_glow_bottom"
            android:alpha="0.25"/>

        <!-- ───────────────────────────────────── -->
        <!--          MAIN CONSTRAINT LAYOUT       -->
        <!-- ───────────────────────────────────── -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/topBar"
                android:layout_width="0dp"
                android:layout_height="72dp"
                app:cardBackgroundColor="#1AC4A882"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeColor="#20C4A882"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Bottom border line of top bar -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0.5dp"
                        android:background="#28C4A882"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- Back Button -->
                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#C4A882"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <!-- Friend Avatar -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarContainer"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="21dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#2AC4A882"
                        app:strokeColor="#50C4A882"
                        app:strokeWidth="1.5dp"
                        app:layout_constraintStart_toEndOf="@id/btnBack"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:id="@+id/ivFriendAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            tools:src="@drawable/ic_person"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Online indicator dot -->
                    <View
                        android:id="@+id/onlineDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_online_dot"
                        app:layout_constraintEnd_toEndOf="@id/avatarContainer"
                        app:layout_constraintBottom_toBottomOf="@id/avatarContainer"/>

                    <!-- Friend Name -->
                    <TextView
                        android:id="@+id/tvFriendName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="16dp"
                        android:text=""
                        android:textColor="#EDD9B8"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"
                        app:layout_constraintStart_toEndOf="@id/avatarContainer"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvStatus"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="Sarah Okafor"/>

                    <!-- Online status -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="16dp"
                        android:text="Online"
                        android:textColor="#70C4A882"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-light"
                        app:layout_constraintStart_toEndOf="@id/avatarContainer"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvFriendName"
                        app:layout_constraintBottom_toBottomOf="parent"/>



                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────── -->
            <!--          MESSAGES LIST              -->
            <!-- ─────────────────────────────────── -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMessages"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical"
                android:fadeScrollbars="true"
                app:layout_constraintTop_toBottomOf="@id/topBar"
                app:layout_constraintBottom_toTopOf="@id/inputCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_message_recieved"/>

            <!-- Date chip (floating, centered) — shown via RecyclerView item type -->

            <!-- ─────────────────────────────────── -->
            <!--        GLASS INPUT BAR              -->
            <!-- ─────────────────────────────────── -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/inputCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1EC4A882"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="#30C4A882"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp">

                    <!-- Emoji / Sticker button -->
                    <ImageView
                        android:id="@+id/btnEmoji"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_emoji"
                        app:tint="#70C4A882"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <!-- Message input field -->
                    <EditText
                        android:id="@+id/etMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Message..."
                        android:textColorHint="#40C4A882"
                        android:textColor="#EDD9B8"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-light"
                        android:background="@null"
                        android:maxLines="5"
                        android:inputType="textMultiLine|textCapSentences"
                        android:imeOptions="actionNone"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:layout_marginStart="4dp"
                        app:layout_constraintStart_toEndOf="@id/btnEmoji"
                        app:layout_constraintEnd_toStartOf="@id/btnAttach"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <!-- Attach button -->
                    <ImageView
                        android:id="@+id/btnAttach"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_attach"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:layout_constraintEnd_toStartOf="@id/btnSend"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <!-- Send button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnSend"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#C4A882"
                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_send"
                            app:tint="#1A0E05"
                            android:layout_gravity="center"/>
                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────── -->
            <!--     SCROLL TO BOTTOM FAB            -->
            <!-- ─────────────────────────────────── -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fabScrollDown"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardCornerRadius="19dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#2AC4A882"
                app:strokeColor="#50C4A882"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/inputCard">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="#C4A882"
                    android:layout_gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>
</layout>
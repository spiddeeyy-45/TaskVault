<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Avatar + Online dot -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#20C4A882"
                app:strokeColor="#28C4A882"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivChatAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_person"
                    android:scaleType="center"
                    android:padding="12dp"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Online indicator dot -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/onlineDot"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="bottom|end"
                app:cardCornerRadius="6.5dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#4CAF50"
                app:strokeColor="#0D0805"
                app:strokeWidth="2dp"
                android:visibility="visible"/>

        </FrameLayout>

        <!-- Name + Last message -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alex Doe"
                android:textColor="#CCF0EAD6"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Alex Doe"/>

            <TextView
                android:id="@+id/tvLastMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hey, have you checked the notes?"
                android:textColor="#45C4A882"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp"
                tools:text="Hey, have you checked the notes?"/>

        </LinearLayout>

        <!-- Time + Unread badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tvChatTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2:34 PM"
                android:textColor="#30C4A882"
                android:textSize="10sp"
                android:fontFamily="sans-serif-light"
                tools:text="2:34 PM"/>

            <!-- Unread count badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/unreadBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#C4A882"
                app:strokeColor="#00000000"
                app:strokeWidth="0dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvUnreadCount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="3"
                    android:textColor="#1A0E05"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:gravity="center"
                    tools:text="3"/>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</layout>